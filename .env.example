# Base URL of the MPrnt backend API (no trailing slash). Platform console talks
# to the same backend as the shop dashboard, but only through this server.
MPRNT_API_URL=http://localhost:3000/api/v1

# Shared secret with the backend (its ADMIN_PROXY_SECRET). Lets the backend
# attribute each request to the operator's real IP for rate limiting and the
# audit log. Generate with: openssl rand -base64 48
MPRNT_PROXY_SECRET=
